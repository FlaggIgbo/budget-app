{
  "name": "budget-app",
  "version": "1.0.0",
  "private": true,
  "description": "Budget App - PEAN Stack",
  "scripts": {
    "prepare": "husky",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "format": "prettier --write \"**/*.{js,ts,html,json,scss,css}\"",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:fix": "npm run lint:fix:server && npm run lint:fix:client",
    "lint:server": "cd server && npx eslint .",
    "lint:client": "cd client && ng lint",
    "lint:fix:server": "cd server && npx eslint . --fix",
    "lint:fix:client": "cd client && ng lint --fix",
    "typecheck": "tsc --noEmit && cd server && npm run typecheck",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test -- --no-watch --browsers=ChromeHeadless",
    "test:e2e": "node --import tsx scripts/e2e-playwright-flow.ts",
    "screenshots": "node --import tsx scripts/generate-screenshots.ts",
    "screenshots:check": "./scripts/pre-push-screenshots.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.65.1",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}
