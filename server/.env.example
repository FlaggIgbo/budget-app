# Database (matches docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=budget_app

# JWT (set a strong secret in production)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Server
PORT=4000
NODE_ENV=development

# CORS - Angular dev server
CORS_ORIGIN=http://localhost:4200

# Plaid bank integration (https://plaid.com/docs)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Auth: In sandbox/development, use email test@example.com + OTP 123456
# Redis (stores temporary 5-minute Email OTP codes)
REDIS_URL=redis://localhost:6379
# Production Email OTP (Nodemailer SMTP settings)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Budget App <your-email@gmail.com>"

# Production Phone SMS OTP (Twilio settings)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+15551234567
