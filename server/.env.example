# Database (matches docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=budget_app

# JWT (set a strong secret in production)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Server
PORT=4000
NODE_ENV=development

# CORS - Angular dev server
CORS_ORIGIN=http://localhost:4200

# Teller.io bank integration (https://teller.io/docs)
TELLER_APPLICATION_ID=app_xxxxxx
TELLER_ENVIRONMENT=sandbox

# Auth: In sandbox/development, use phone 555-555-5555 + OTP 123456
# Local dev: place certificate.pem and private_key.pem in server/certs/teller/
# Or set paths:
# TELLER_CERT_PATH=./certs/teller/certificate.pem
# TELLER_KEY_PATH=./certs/teller/private_key.pem
# For Render: use TELLER_CERT and TELLER_KEY with full PEM content (see docs/internal/TELLER_SETUP.md)
