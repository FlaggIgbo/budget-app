# ============================================================================
# ENVIRONMENT CONFIGURATION ("development" for local/Vercel dev, "prod"/"production" for live)
# Supports env=development / ENV=development (and VERCEL_ENV=development) for dev,
# and env=prod / ENV=production (and VERCEL_ENV=production) for production.
# ============================================================================
ENV=development
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:4200
# Optional WebAuthn / Passkey overrides (defaults derive from CORS_ORIGIN)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Budget App
# WEBAUTHN_ORIGIN=http://localhost:4200

# PostgreSQL Database (matches docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=budget_app

# Redis (stores 5-minute OTP codes AND 1-hour auth session tokens)
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600

# RabbitMQ (processes balance/transaction sync jobs from login & daily CRON)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
DAILY_SYNC_CRON_INTERVAL_MS=86400000

# Plaid Bank Integration (https://plaid.com/docs)
# In development (localhost), PLAID_ENV can be "sandbox" or "development"
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Bank Statement Object Storage ("minio" for local Docker S3, "r2" for Cloudflare R2)
STORAGE_PROVIDER=minio
STATEMENTS_BUCKET=budget-statements

# Local MinIO S3 cluster settings (matches docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Production Cloudflare R2 settings
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Gemini API (for LLM Financial Assistant chat feature)
GEMINI_API_KEY=

# Sentry Error Tracking (optional)
SENTRY_DSN=

# Token Encryption Key (Secrets Vault for Plaid access_tokens)
TOKEN_ENCRYPTION_KEY=your-secret-key-change-in-production

# Production Email OTP & Finance Summaries (Nodemailer SMTP settings)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Budget App <your-email@gmail.com>"

# Production Phone SMS OTP (Twilio settings)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+15551234567

# Web Push Notifications (RFC 8292 VAPID ES256 P-256 keys; auto-generated ephemerally in dev)
# Generate with: node -e "console.log(require('./push_service').pushService.generateVapidKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@budgetapp.local
