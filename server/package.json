{
  "name": "budget-app-api",
  "version": "1.0.0",
  "description": "Budget App REST API - Node.js + Express + Sequelize + PostgreSQL",
  "main": "index.ts",
  "scripts": {
    "start": "node --import tsx index.ts",
    "dev": "node --import tsx --watch index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "keywords": [
    "node",
    "express",
    "sequelize",
    "postgresql",
    "budget",
    "rest",
    "api"
  ],
  "license": "ISC",
  "dependencies": {
    "amqplib": "^2.4.2",
    "express": "^4.18.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "redis": "^6.3.1",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^10.0.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.74.0"
  }
}
