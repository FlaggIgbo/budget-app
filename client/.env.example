# ============================================================================
# CLIENT ENVIRONMENT CONFIGURATION (Vercel Development vs. Production)
# - Vercel Development (or local .env): set env=development to build Angular
#   with environment.development.ts (enabling the Dev Test Account banner).
# - Vercel Production: set env=prod (or ENV=production) to build Angular with
#   environment.production.ts (banner strictly disabled).
# ============================================================================
env=development
